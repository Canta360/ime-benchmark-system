{"kind": "ja", "text": "今日は朝から雨だった。傘を忘れて濡れてしまった。", "chunks": ["きょうは", "あさから", "あめだった。", "かさを", "わすれて", "ぬれてしまった。"]}
{"kind": "ja", "text": "やっと週末だ。今日は一日中寝ていたい。", "chunks": ["やっと", "しゅうまつだ。", "きょうは", "いちにちじゅう", "ねていたい。"]}
{"kind": "ja", "text": "駅前に新しいパン屋ができた。クロワッサンがおいしかった。また行きたい。", "chunks": ["えきまえに", "あたらしい", "ぱんやが", "できた。", "くろわっさんが", "おいしかった。", "また", "いきたい。"]}
{"kind": "ja", "text": "電車が止まって会社に遅れた。上司に事情を説明した。", "chunks": ["でんしゃが", "とまって", "かいしゃに", "おくれた。", "じょうしに", "じじょうを", "せつめいした。"]}
{"kind": "ja", "text": "最近、朝のジョギングを始めた。三日坊主にならないようにしたい。", "chunks": ["さいきん、", "あさの", "じょぎんぐを", "はじめた。", "みっかぼうずに", "ならないように", "したい。"]}
{"kind": "ja", "text": "映画を見て泣いてしまった。最後の場面がずるい。", "chunks": ["えいがを", "みて", "ないてしまった。", "さいごの", "ばめんが", "ずるい。"]}
{"kind": "ja", "text": "引っ越しの準備が全然進まない。段ボールの山を見てため息が出る。", "chunks": ["ひっこしの", "じゅんびが", "ぜんぜん", "すすまない。", "だんぼーるの", "やまを", "みて", "ためいきが", "でる。"]}
{"kind": "ja", "text": "昨日の夜ご飯はカレーだった。今日も余りを食べる。", "chunks": ["きのうの", "よるごはんは", "かれーだった。", "きょうも", "あまりを", "たべる。"]}
{"kind": "ja", "text": "電気代の請求書が届いた。思ったより高くて驚いた。", "chunks": ["でんきだいの", "せいきゅうしょが", "とどいた。", "おもったより", "たかくて", "おどろいた。"]}
{"kind": "ja", "text": "実家の母から野菜が届いた。ありがたいけど量が多い。", "chunks": ["じっかの", "ははから", "やさいが", "とどいた。", "ありがたいけど", "りょうが", "おおい。"]}
{"kind": "ja", "text": "眠い。コーヒーを三杯飲んだのに眠い。", "chunks": ["ねむい。", "こーひーを", "さんばい", "のんだのに", "ねむい。"]}
{"kind": "ja", "text": "今日は友達の結婚式だった。幸せそうな二人を見て嬉しくなった。", "chunks": ["きょうは", "ともだちの", "けっこんしきだった。", "しあわせそうな", "ふたりを", "みて", "うれしくなった。"]}
{"kind": "ja", "text": "新しい靴を買ったら靴擦れした。しばらく絆創膏が手放せない。", "chunks": ["あたらしい", "くつを", "かったら", "くつずれした。", "しばらく", "ばんそうこうが", "てばなせない。"]}
{"kind": "ja", "text": "台風が近づいているらしい。明日は早めに帰ろう。", "chunks": ["たいふうが", "ちかづいているらしい。", "あしたは", "はやめに", "かえろう。"]}
{"kind": "ja", "text": "病院の待ち時間が長かった。本を持って行って正解だった。", "chunks": ["びょういんの", "まちじかんが", "ながかった。", "ほんを", "もっていって", "せいかいだった。"]}
{"kind": "ja", "text": "最近肩こりがひどい。ストレッチを毎日やってみよう。", "chunks": ["さいきん", "かたこりが", "ひどい。", "すとれっちを", "まいにち", "やってみよう。"]}
{"kind": "ja", "text": "散歩の途中で猫に会った。じっとこちらを見ていた。かわいかった。", "chunks": ["さんぽの", "とちゅうで", "ねこに", "あった。", "じっと", "こちらを", "みていた。", "かわいかった。"]}
{"kind": "ja", "text": "やっと宿題が終わった。明日からは遊べる。", "chunks": ["やっと", "しゅくだいが", "おわった。", "あしたからは", "あそべる。"]}
{"kind": "ja", "text": "友達に誘われて久しぶりに飲みに行った。話が尽きなくて終電を逃した。", "chunks": ["ともだちに", "さそわれて", "ひさしぶりに", "のみに", "いった。", "はなしが", "つきなくて", "しゅうでんを", "のがした。"]}
{"kind": "ja", "text": "会議が長引いてお昼を食べそびれた。お腹がすいた。", "chunks": ["かいぎが", "ながびいて", "おひるを", "たべそびれた。", "おなかが", "すいた。"]}
{"kind": "ja", "text": "図書館で勉強していたらいつの間にか閉館時間だった。集中できた日は気持ちがいい。", "chunks": ["としょかんで", "べんきょうしていたら", "いつのまにか", "へいかんじかんだった。", "しゅうちゅうできた", "ひは", "きもちが", "いい。"]}
{"kind": "ja", "text": "スマホの充電が切れそう。充電器を家に忘れてきた。最悪だ。", "chunks": ["すまほの", "じゅうでんが", "きれそう。", "じゅうでんきを", "いえに", "わすれてきた。", "さいあくだ。"]}
{"kind": "ja", "text": "雪が積もって駅まで歩くのに三十分かかった。靴の中までびしょ濡れだ。", "chunks": ["ゆきが", "つもって", "えきまで", "あるくのに", "さんじゅっぷん", "かかった。", "くつの", "なかまで", "びしょぬれだ。"]}
{"kind": "ja", "text": "母の誕生日に花を贈った。喜んでくれて安心した。", "chunks": ["ははの", "たんじょうびに", "はなを", "おくった。", "よろこんでくれて", "あんしんした。"]}
{"kind": "ja", "text": "最近の天気は気まぐれだ。朝は晴れていたのに夕方は大雨だった。", "chunks": ["さいきんの", "てんきは", "きまぐれだ。", "あさは", "はれていたのに", "ゆうがたは", "おおあめだった。"]}
{"kind": "ja", "text": "今日は何もする気が起きない。たまにはそんな日もあっていい。", "chunks": ["きょうは", "なにも", "する", "きが", "おきない。", "たまには", "そんな", "ひも", "あっていい。"]}
{"kind": "ja", "text": "ベランダのトマトが赤くなった。初めての収穫が嬉しい。", "chunks": ["べらんだの", "とまとが", "あかくなった。", "はじめての", "しゅうかくが", "うれしい。"]}
{"kind": "ja", "text": "電車で席を譲ったらお礼を言われた。小さなことだけど一日いい気分だった。", "chunks": ["でんしゃで", "せきを", "ゆずったら", "おれいを", "いわれた。", "ちいさな", "ことだけど", "いちにち", "いい", "きぶんだった。"]}
{"kind": "ja", "text": "息子が自転車に乗れるようになった。何度も転んで泣いたけど諦めなかった。", "chunks": ["むすこが", "じてんしゃに", "のれるように", "なった。", "なんども", "ころんで", "ないたけど", "あきらめなかった。"]}
{"kind": "ja", "text": "冷蔵庫の中身がほぼ空っぽだ。買い物に行かないと夕飯が作れない。", "chunks": ["れいぞうこの", "なかみが", "ほぼ", "からっぽだ。", "かいものに", "いかないと", "ゆうはんが", "つくれない。"]}
{"kind": "ja", "text": "朝の満員電車は本当にしんどい。座れた日は一日が違う。", "chunks": ["あさの", "まんいんでんしゃは", "ほんとうに", "しんどい。", "すわれた", "ひは", "いちにちが", "ちがう。"]}
{"kind": "ja", "text": "新しい上司は話しやすい人だった。この職場でやっていけそうだ。", "chunks": ["あたらしい", "じょうしは", "はなしやすい", "ひとだった。", "この", "しょくばで", "やっていけそうだ。"]}
{"kind": "ja", "text": "昨日の地震には驚いた。幸い家族は無事だった。", "chunks": ["きのうの", "じしんには", "おどろいた。", "さいわい", "かぞくは", "ぶじだった。"]}
{"kind": "ja", "text": "夏祭りで花火を見た。人が多すぎて疲れたけど、きれいだった。", "chunks": ["なつまつりで", "はなびを", "みた。", "ひとが", "おおすぎて", "つかれたけど、", "きれいだった。"]}
{"kind": "ja", "text": "健康診断の結果が返ってきた。要再検査と書いてあって不安だ。", "chunks": ["けんこうしんだんの", "けっかが", "かえってきた。", "ようさいけんさと", "かいてあって", "ふあんだ。"]}
{"kind": "ja", "text": "コンビニの新作スイーツを試した。思ったより甘くなくておいしい。", "chunks": ["こんびにの", "しんさく", "すいーつを", "ためした。", "おもったより", "あまくなくて", "おいしい。"]}
{"kind": "ja", "text": "窓を開けると秋の匂いがした。そろそろ衣替えの季節だ。", "chunks": ["まどを", "あけると", "あきの", "においが", "した。", "そろそろ", "ころもがえの", "きせつだ。"]}
{"kind": "ja", "text": "犬の散歩で毎朝早起きしている。おかげで健康になった気がする。", "chunks": ["いぬの", "さんぽで", "まいあさ", "はやおきしている。", "おかげで", "けんこうに", "なった", "きが", "する。"]}
{"kind": "ja", "text": "祖父の家に泊まりに行った。縁側で食べたスイカが最高だった。", "chunks": ["そふの", "いえに", "とまりに", "いった。", "えんがわで", "たべた", "すいかが", "さいこうだった。"]}
{"kind": "ja", "text": "大掃除をしたら懐かしい写真が出てきた。つい手が止まって見入ってしまった。", "chunks": ["おおそうじを", "したら", "なつかしい", "しゃしんが", "でてきた。", "つい", "てが", "とまって", "みいってしまった。"]}
{"kind": "ja", "text": "貯金が少しずつ増えている。目標の百万円まであと半分だ。", "chunks": ["ちょきんが", "すこしずつ", "ふえている。", "もくひょうの", "ひゃくまんえんまで", "あと", "はんぶんだ。"]}
{"kind": "ja", "text": "週末は山に登る予定だ。天気が晴れるといいな。", "chunks": ["しゅうまつは", "やまに", "のぼる", "よていだ。", "てんきが", "はれると", "いいな。"]}
{"kind": "ja", "text": "今日はお客さんに怒られた。落ち込んだけど次に活かすしかない。", "chunks": ["きょうは", "おきゃくさんに", "おこられた。", "おちこんだけど", "つぎに", "いかすしか", "ない。"]}
{"kind": "ja", "text": "友達の子供が生まれた。小さな手を見て感動した。", "chunks": ["ともだちの", "こどもが", "うまれた。", "ちいさな", "てを", "みて", "かんどうした。"]}
{"kind": "ja", "text": "新しい趣味に陶芸を始めた。土に触れていると心が落ち着く。", "chunks": ["あたらしい", "しゅみに", "とうげいを", "はじめた。", "つちに", "ふれていると", "こころが", "おちつく。"]}
{"kind": "ja", "text": "エレベーターが故障して階段で八階まで登った。足が笑っている。", "chunks": ["えれべーたーが", "こしょうして", "かいだんで", "はっかいまで", "のぼった。", "あしが", "わらっている。"]}
{"kind": "ja", "text": "雨上がりの空に虹が出ていた。思わず立ち止まって眺めた。", "chunks": ["あめあがりの", "そらに", "にじが", "でていた。", "おもわず", "たちどまって", "ながめた。"]}
{"kind": "ja", "text": "朝からずっと頭が痛い。薬を飲んで少し休もう。", "chunks": ["あさから", "ずっと", "あたまが", "いたい。", "くすりを", "のんで", "すこし", "やすもう。"]}
{"kind": "ja", "text": "久しぶりに髪を切った。短くしたら首が寒い。", "chunks": ["ひさしぶりに", "かみを", "きった。", "みじかくしたら", "くびが", "さむい。"]}
{"kind": "ja", "text": "通勤時間を使って英語を勉強している。続けるのが大事だと思う。", "chunks": ["つうきん", "じかんを", "つかって", "えいごを", "べんきょうしている。", "つづけるのが", "だいじだと", "おもう。"]}
{"kind": "ja", "text": "ケーキを焼いたら焦がしてしまった。次はオーブンの温度に気をつけよう。", "chunks": ["けーきを", "やいたら", "こがしてしまった。", "つぎは", "おーぶんの", "おんどに", "きを", "つけよう。"]}
{"kind": "ja", "text": "商店街のコロッケを買って帰った。揚げたては何よりもおいしい。", "chunks": ["しょうてんがいの", "ころっけを", "かって", "かえった。", "あげたては", "なによりも", "おいしい。"]}
{"kind": "ja", "text": "読みかけの小説をやっと読み終えた。余韻がまだ残っている。", "chunks": ["よみかけの", "しょうせつを", "やっと", "よみおえた。", "よいんが", "まだ", "のこっている。"]}
{"kind": "ja", "text": "雨の日の図書館は静かで好きだ。窓の外を眺めながら本を読む。", "chunks": ["あめの", "ひの", "としょかんは", "しずかで", "すきだ。", "まどの", "そとを", "ながめながら", "ほんを", "よむ。"]}
{"kind": "ja", "text": "寝坊して朝ごはんを食べ損ねた。昼までお腹が鳴りっぱなしだった。", "chunks": ["ねぼうして", "あさごはんを", "たべそこねた。", "ひるまで", "おなかが", "なりっぱなしだった。"]}
{"kind": "ja", "text": "同僚が会社を辞めると聞いて驚いた。寂しくなるけど応援したい。", "chunks": ["どうりょうが", "かいしゃを", "やめると", "きいて", "おどろいた。", "さびしく", "なるけど", "おうえんしたい。"]}
{"kind": "ja", "text": "最近、夜は鍋ばかり食べている。体が温まって眠りやすい。", "chunks": ["さいきん、", "よるは", "なべばかり", "たべている。", "からだが", "あたたまって", "ねむりやすい。"]}
{"kind": "ja", "text": "昨日のサッカーは接戦だった。最後の十分間は息もできなかった。", "chunks": ["きのうの", "さっかーは", "せっせんだった。", "さいごの", "じゅっぷんかんは", "いきも", "できなかった。"]}
{"kind": "ja", "text": "電話で母と一時間も話した。話題は主に近所の噂話だった。", "chunks": ["でんわで", "ははと", "いちじかんも", "はなした。", "わだいは", "おもに", "きんじょの", "うわさばなしだった。"]}
{"kind": "ja", "text": "母の日にエプロンを贈った。さっそく使ってくれているらしい。", "chunks": ["ははの", "ひに", "えぷろんを", "おくった。", "さっそく", "つかってくれているらしい。"]}
{"kind": "ja", "text": "ベッドの上で一日中ゴロゴロしていた。何もしなかったのに疲れた。", "chunks": ["べっどの", "うえで", "いちにちじゅう", "ごろごろしていた。", "なにも", "しなかったのに", "つかれた。"]}
{"kind": "ja", "text": "大雨で電車が運休になった。仕方なく在宅で仕事をした。", "chunks": ["おおあめで", "でんしゃが", "うんきゅうに", "なった。", "しかたなく", "ざいたくで", "しごとを", "した。"]}
{"kind": "ja", "text": "隣の席の人がずっと咳をしている。うつらないか心配だ。", "chunks": ["となりの", "せきの", "ひとが", "ずっと", "せきを", "している。", "うつらないか", "しんぱいだ。"]}
{"kind": "ja", "text": "ふと思い立って海まで行ってきた。波の音を聞いたら気持ちが軽くなった。", "chunks": ["ふと", "おもいたって", "うみまで", "いってきた。", "なみの", "おとを", "きいたら", "きもちが", "かるくなった。"]}
{"kind": "ja", "text": "今日は残業なしで帰れた。久しぶりに家族と夕食を食べた。", "chunks": ["きょうは", "ざんぎょうなしで", "かえれた。", "ひさしぶりに", "かぞくと", "ゆうしょくを", "たべた。"]}
{"kind": "ja", "text": "財布を落として焦った。交番に届いていてほっとした。", "chunks": ["さいふを", "おとして", "あせった。", "こうばんに", "とどいていて", "ほっとした。"]}
{"kind": "ja", "text": "三年ぶりに同窓会に出た。みんなあまり変わっていなかった。", "chunks": ["さんねんぶりに", "どうそうかいに", "でた。", "みんな", "あまり", "かわっていなかった。"]}
{"kind": "ja", "text": "今朝の空気は澄んでいて気持ちがいい。深呼吸をしてから出勤した。", "chunks": ["けさの", "くうきは", "すんでいて", "きもちが", "いい。", "しんこきゅうを", "してから", "しゅっきんした。"]}
{"kind": "ja", "text": "庭の雑草が伸びすぎている。週末に草むしりをしなければ。", "chunks": ["にわの", "ざっそうが", "のびすぎている。", "しゅうまつに", "くさむしりを", "しなければ。"]}
{"kind": "ja", "text": "いつもの定食屋が閉店していた。長年通った店なので寂しい。", "chunks": ["いつもの", "ていしょくやが", "へいてん", "していた。", "ながねん", "かよった", "みせなので", "さびしい。"]}
{"kind": "ja", "text": "雲ひとつない快晴だった。洗濯物がよく乾いた。", "chunks": ["くも", "ひとつ", "ない", "かいせいだった。", "せんたくものが", "よく", "かわいた。"]}
{"kind": "ja", "text": "弟が来月結婚するらしい。祝いに何を贈ろうか悩んでいる。", "chunks": ["おとうとが", "らいげつ", "けっこんするらしい。", "いわいに", "なにを", "おくろうか", "なやんでいる。"]}
{"kind": "ja", "text": "アルバイトの面接に落ちた。気持ちを切り替えて次を探そう。", "chunks": ["あるばいとの", "めんせつに", "おちた。", "きもちを", "きりかえて", "つぎを", "さがそう。"]}
{"kind": "ja", "text": "母が作った漬物はやっぱり格別だ。ご飯が何杯でも食べられる。", "chunks": ["ははが", "つくった", "つけものは", "やっぱり", "かくべつだ。", "ごはんが", "なんばいでも", "たべられる。"]}
{"kind": "ja", "text": "おばあちゃんから手紙が届いた。丁寧な字で近況が書かれていた。", "chunks": ["おばあちゃんから", "てがみが", "とどいた。", "ていねいな", "じで", "きんきょうが", "かかれていた。"]}
{"kind": "ja", "text": "友達とキャンプに行く計画を立てている。まずは道具をそろえないと。", "chunks": ["ともだちと", "きゃんぷに", "いく", "けいかくを", "たてている。", "まずは", "どうぐを", "そろえないと。"]}
{"kind": "ja", "text": "定期券の期限が切れていた。改札で止められて恥ずかしかった。", "chunks": ["ていきけんの", "きげんが", "きれていた。", "かいさつで", "とめられて", "はずかしかった。"]}
{"kind": "ja", "text": "今日は一日中パソコンの前に座っていた。肩と目がもう限界だ。", "chunks": ["きょうは", "いちにちじゅう", "ぱそこんの", "まえに", "すわっていた。", "かたと", "めが", "もう", "げんかいだ。"]}
{"kind": "ja", "text": "仕事帰りに本屋に寄った。気になっていた本が見つかって嬉しい。", "chunks": ["しごとがえりに", "ほんやに", "よった。", "きに", "なっていた", "ほんが", "みつかって", "うれしい。"]}
{"kind": "ja", "text": "雨の音を聞きながらお茶を飲む。こんな時間がずっと続けばいい。", "chunks": ["あめの", "おとを", "ききながら", "おちゃを", "のむ。", "こんな", "じかんが", "ずっと", "つづけば", "いい。"]}
{"kind": "ja", "text": "満月がとてもきれいな夜だった。しばらくベランダで眺めていた。", "chunks": ["まんげつが", "とても", "きれいな", "よるだった。", "しばらく", "べらんだで", "ながめていた。"]}
{"kind": "ja", "text": "友達の引っ越しを手伝った。重い荷物ばかりで腕が痛い。", "chunks": ["ともだちの", "ひっこしを", "てつだった。", "おもい", "にもつばかりで", "うでが", "いたい。"]}
{"kind": "ja", "text": "締め切りまであと三日しかない。今夜から本気を出す。", "chunks": ["しめきりまで", "あと", "みっかしか", "ない。", "こんやから", "ほんきを", "だす。"]}
{"kind": "ja", "text": "商店街の福引で温泉旅行が当たった。まさか当たるとは思わなかった。", "chunks": ["しょうてんがいの", "ふくびきで", "おんせんりょこうが", "あたった。", "まさか", "あたるとは", "おもわなかった。"]}

{"text": "夕飯の前にお風呂に入った。", "chunks": ["ゆうはんの", "まえに", "おふろに", "はいった。"], "level": "A", "use": "daily"}
{"text": "あとでゆっくり話そうね。", "chunks": ["あとで", "ゆっくり", "はなそうね。"], "level": "A", "use": "chat"}

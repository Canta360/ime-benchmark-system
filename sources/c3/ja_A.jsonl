{"text": "久しぶりに会えて嬉しかった。また近いうちにご飯に行こう。", "chunks": ["ひさしぶりに", "あえて", "うれしかった。また", "ちかいうちに", "ごはんに", "いこう。"], "level": "A", "use": "chat"}
{"text": "初めての仕事で分からないことばかりですが、頑張ります。", "chunks": ["はじめての", "しごとで", "わからない", "ことばかりですが、がんばります。"], "level": "A", "use": "work"}
{"text": "公園の池に、大きな鯉がたくさん泳いでいるのが見えた。", "chunks": ["こうえんの", "いけに、おおきな", "こいが", "たくさん", "およいでいるのが", "みえた。"], "level": "A", "use": "daily"}
{"text": "今夜は月がきれいだから、少し外を歩いてみない？", "chunks": ["こんやは", "つきが", "きれいだから、すこし", "そとを", "あるいてみない？"], "level": "A", "use": "chat"}
{"text": "締め切りが近いので、今週は毎日遅くまで残って作業をしています。", "chunks": ["しめきりが", "ちかいので、こんしゅうは", "まいにち", "おそくまで", "のこって", "さぎょうを", "しています。"], "level": "A", "use": "work"}
{"text": "朝からずっと掃除をしていたら、部屋がすっかりきれいになった。", "chunks": ["あさから", "ずっと", "そうじを", "していたら、へやが", "すっかり", "きれいに", "なった。"], "level": "A", "use": "daily"}
{"text": "今夜は星がきれいだ。", "chunks": ["こんやは", "ほしが", "きれいだ。"], "level": "A", "use": "daily"}
{"text": "ごはん食べた？", "chunks": ["ごはん", "たべた？"], "level": "A", "use": "chat"}
{"text": "会議を始めましょう。", "chunks": ["かいぎを", "はじめましょう。"], "level": "A", "use": "work"}
{"text": "庭の木に実がなった。", "chunks": ["にわの", "きに", "みが", "なった。"], "level": "A", "use": "daily"}
{"text": "昨日はごめんね。", "chunks": ["きのうは", "ごめんね。"], "level": "A", "use": "chat"}
{"text": "明日は休みをいただきます。", "chunks": ["あしたは", "やすみを", "いただきます。"], "level": "A", "use": "work"}
{"text": "友達と電話で話した。", "chunks": ["ともだちと", "でんわで", "はなした。"], "level": "A", "use": "daily"}
{"text": "それ、おいしそうだね。", "chunks": ["それ、おいしそうだね。"], "level": "A", "use": "chat"}
{"text": "今月の予定を確認します。", "chunks": ["こんげつの", "よていを", "かくにん", "します。"], "level": "A", "use": "work"}
{"text": "歯を磨いてから寝る。", "chunks": ["はを", "みがいてから", "ねる。"], "level": "A", "use": "daily"}
{"text": "宿題手伝ってくれる？", "chunks": ["しゅくだい", "てつだって", "くれる？"], "level": "A", "use": "chat"}
{"text": "会社の前で待っています。", "chunks": ["かいしゃの", "まえで", "まっています。"], "level": "A", "use": "work"}
{"text": "川の水がとても冷たい。", "chunks": ["かわの", "みずが", "とても", "つめたい。"], "level": "A", "use": "daily"}
{"text": "すぐ行くから待ってて。", "chunks": ["すぐ", "いくから", "まってて。"], "level": "A", "use": "chat"}
{"text": "名刺を忘れてしまいました。", "chunks": ["めいしを", "わすれて", "しまいました。"], "level": "A", "use": "work"}
{"text": "魚を焼いて夕飯にした。", "chunks": ["さかなを", "やいて", "ゆうはんに", "した。"], "level": "A", "use": "daily"}
{"text": "今日はいい天気だね。", "chunks": ["きょうは", "いい", "てんきだね。"], "level": "A", "use": "chat"}
{"text": "朝一番に連絡を入れます。", "chunks": ["あさいちばんに", "れんらくを", "いれます。"], "level": "A", "use": "work"}
{"text": "姉の子どもが遊びに来た。", "chunks": ["あねの", "こどもが", "あそびに", "きた。"], "level": "A", "use": "daily"}
{"text": "お昼はどこで食べる？", "chunks": ["おひるは", "どこで", "たべる？"], "level": "A", "use": "chat"}
{"text": "工場の見学に行きました。", "chunks": ["こうじょうの", "けんがくに", "いきました。"], "level": "A", "use": "work"}
{"text": "部屋の電気をつけてください。", "chunks": ["へやの", "でんきを", "つけて", "ください。"], "level": "A", "use": "daily"}
{"text": "テストの結果どうだった？", "chunks": ["てすとの", "けっか", "どうだった？"], "level": "A", "use": "chat"}
{"text": "会議室を予約しておきます。", "chunks": ["かいぎしつを", "よやくして", "おきます。"], "level": "A", "use": "work"}
{"text": "道に迷って遅くなった。", "chunks": ["みちに", "まよって", "おそく", "なった。"], "level": "A", "use": "daily"}
{"text": "週末は何するの？", "chunks": ["しゅうまつは", "なにするの？"], "level": "A", "use": "chat"}
{"text": "先月の報告をまとめました。", "chunks": ["せんげつの", "ほうこくを", "まとめました。"], "level": "A", "use": "work"}
{"text": "駅前の本屋で雑誌を買った。", "chunks": ["えきまえの", "ほんやで", "ざっしを", "かった。"], "level": "A", "use": "daily"}
{"text": "眠いけど頑張って起きてる。", "chunks": ["ねむいけど", "がんばって", "おきてる。"], "level": "A", "use": "chat"}
{"text": "本日はありがとうございました。", "chunks": ["ほんじつは", "ありがとう", "ございました。"], "level": "A", "use": "work"}
{"text": "ぬるいお湯にゆっくり浸かった。", "chunks": ["ぬるい", "おゆに", "ゆっくり", "つかった。"], "level": "A", "use": "daily"}
{"text": "急にごめん、今話せる？", "chunks": ["きゅうに", "ごめん、いま", "はなせる？"], "level": "A", "use": "chat"}
{"text": "このデータは来週使います。", "chunks": ["この", "でーたは", "らいしゅう", "つかいます。"], "level": "A", "use": "work"}
{"text": "窓の外で雨の音がしている。", "chunks": ["まどの", "そとで", "あめの", "おとが", "している。"], "level": "A", "use": "daily"}
{"text": "その映画、私も見たいな。", "chunks": ["その", "えいが、わたしも", "みたいな。"], "level": "A", "use": "chat"}
{"text": "お待たせして申し訳ありません。", "chunks": ["おまたせして", "もうしわけ", "ありません。"], "level": "A", "use": "work"}
{"text": "八百屋さんでみかんをおまけしてもらった。", "chunks": ["やおやさんで", "みかんを", "おまけして", "もらった。"], "level": "A", "use": "daily"}
{"text": "雪が降ってきたよ、外見てみて。", "chunks": ["ゆきが", "ふってきたよ、そと", "みてみて。"], "level": "A", "use": "chat"}
{"text": "その点については改めてご相談します。", "chunks": ["その", "てんについては", "あらためて", "ごそうだん", "します。"], "level": "A", "use": "work"}
{"text": "仕事帰りに本屋に寄って、気になっていた小説を買った。", "chunks": ["しごとがえりに", "ほんやに", "よって、きに", "なっていた", "しょうせつを", "かった。"], "level": "A", "use": "daily"}
{"text": "あのさ、ちょっと相談したいことがあるんだけど、今いい？", "chunks": ["あのさ、ちょっと", "そうだん", "したい", "ことが", "あるんだけど、いま", "いい？"], "level": "A", "use": "chat"}
{"text": "来月の旅行の件ですが、日程が決まり次第お知らせします。", "chunks": ["らいげつの", "りょこうの", "けんですが、にっていが", "きまりしだい", "おしらせします。"], "level": "A", "use": "work"}
{"text": "庭の草むしりをしていたら、あっという間に日が暮れた。", "chunks": ["にわの", "くさむしりを", "していたら、あっというまに", "ひが", "くれた。"], "level": "A", "use": "daily"}
{"text": "楽しみにしていた旅行だから、天気が良くなるといいな。", "chunks": ["たのしみに", "していた", "りょこうだから、てんきが", "よく", "なると", "いいな。"], "level": "A", "use": "chat"}
{"text": "システムの調子が悪かったので、少し作業が遅れています。", "chunks": ["しすてむの", "ちょうしが", "わるかったので、すこし", "さぎょうが", "おくれています。"], "level": "A", "use": "work"}
{"text": "友達に誘われて、初めてヨガの教室に行ってみた。", "chunks": ["ともだちに", "さそわれて、はじめて", "よがの", "きょうしつに", "いってみた。"], "level": "A", "use": "daily"}
{"text": "引っ越しの準備は進んでる？手伝えることがあったら言ってね。", "chunks": ["ひっこしの", "じゅんびは", "すすんでる？てつだえる", "ことが", "あったら", "いってね。"], "level": "A", "use": "chat"}
{"text": "参加できる方は、今週の金曜日までに返事をください。", "chunks": ["さんか", "できる", "かたは、こんしゅうの", "きんようびまでに", "へんじを", "ください。"], "level": "A", "use": "work"}
{"text": "小さな頃から使っているお気に入りのカップを割ってしまった。", "chunks": ["ちいさな", "ころから", "つかっている", "おきにいりの", "かっぷを", "わって", "しまった。"], "level": "A", "use": "daily"}
{"text": "このあいだ話したお店、予約が取れたから行こうよ。", "chunks": ["このあいだ", "はなした", "おみせ、よやくが", "とれたから", "いこうよ。"], "level": "A", "use": "chat"}
{"text": "新しい機械の使い方を、先輩が丁寧に教えてくれました。", "chunks": ["あたらしい", "きかいの", "つかいかたを、せんぱいが", "ていねいに", "おしえて", "くれました。"], "level": "A", "use": "work"}
{"text": "夜遅くまで勉強していたので、朝起きるのがつらかった。", "chunks": ["よるおそくまで", "べんきょう", "していたので、あさ", "おきるのが", "つらかった。"], "level": "A", "use": "daily"}
{"text": "今日は早く帰れそうだから、夜に電話するね。", "chunks": ["きょうは", "はやく", "かえれそうだから、よるに", "でんわするね。"], "level": "A", "use": "chat"}
{"text": "会議の議題をあらかじめ送っておきますので、目を通しておいてください。", "chunks": ["かいぎの", "ぎだいを", "あらかじめ", "おくっておきますので、めを", "とおして", "おいて", "ください。"], "level": "A", "use": "work"}
{"text": "思ったより早く仕事が終わったので、久しぶりに映画を見に行った。", "chunks": ["おもったより", "はやく", "しごとが", "おわったので、ひさしぶりに", "えいがを", "みに", "いった。"], "level": "A", "use": "daily"}
{"text": "朝の空気が澄んでいる。", "chunks": ["あさの", "くうきが", "すんでいる。"], "level": "A", "use": "daily"}
{"text": "また電話するね。", "chunks": ["また", "でんわするね。"], "level": "A", "use": "chat"}
{"text": "書類を受け取りました。", "chunks": ["しょるいを", "うけとりました。"], "level": "A", "use": "work"}
{"text": "母が料理を作ってくれた。", "chunks": ["ははが", "りょうりを", "つくって", "くれた。"], "level": "A", "use": "daily"}
{"text": "明日の約束、忘れないでね。", "chunks": ["あしたの", "やくそく、わすれないでね。"], "level": "A", "use": "chat"}
{"text": "お先にお昼に行ってきます。", "chunks": ["おさきに", "おひるに", "いってきます。"], "level": "A", "use": "work"}

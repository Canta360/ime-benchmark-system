{"text": "毎日少しずつ歩くようにしている。", "chunks": ["まいにち", "すこしずつ", "あるくように", "している。"], "level": "A", "use": "daily"}
{"text": "まだ起きてる？", "chunks": ["まだ", "おきてる？"], "level": "A", "use": "chat"}

{"text": "今日は早めに帰ります。", "chunks": ["きょうは", "はやめに", "かえります。"], "level": "A", "use": "chat"}
{"text": "明日の朝は雨らしいよ。", "chunks": ["あしたの", "あさは", "あめらしいよ。"], "level": "A", "use": "chat"}
{"text": "牛乳を買ってきてください。", "chunks": ["ぎゅうにゅうを", "かってきて", "ください。"], "level": "A", "use": "daily"}
{"text": "会議は三階の部屋です。", "chunks": ["かいぎは", "さんがいの", "へやです。"], "level": "A", "use": "work"}
{"text": "昨日の映画、すごく面白かった。", "chunks": ["きのうの", "えいが、すごく", "おもしろかった。"], "level": "A", "use": "chat"}
{"text": "朝ごはんにパンを食べた。", "chunks": ["あさごはんに", "ぱんを", "たべた。"], "level": "A", "use": "daily"}
{"text": "資料を机の上に置いておきました。", "chunks": ["しりょうを", "つくえの", "うえに", "おいて", "おきました。"], "level": "A", "use": "work"}
{"text": "今度の休みに一緒に出かけませんか。", "chunks": ["こんどの", "やすみに", "いっしょに", "でかけませんか。"], "level": "A", "use": "chat"}
{"text": "洗濯物を外に干しておいたよ。", "chunks": ["せんたくものを", "そとに", "ほして", "おいたよ。"], "level": "A", "use": "daily"}
{"text": "お客様から電話がありました。", "chunks": ["おきゃくさまから", "でんわが", "ありました。"], "level": "A", "use": "work"}
{"text": "ありがとう、とても助かりました。", "chunks": ["ありがとう、とても", "たすかりました。"], "level": "A", "use": "chat"}
{"text": "夕方から少し寒くなってきた。", "chunks": ["ゆうがたから", "すこし", "さむく", "なってきた。"], "level": "A", "use": "daily"}
{"text": "報告書は今週中に出します。", "chunks": ["ほうこくしょは", "こんしゅうちゅうに", "だします。"], "level": "A", "use": "work"}
{"text": "お腹がすいたから何か食べに行こう。", "chunks": ["おなかが", "すいたから", "なにか", "たべに", "いこう。"], "level": "A", "use": "chat"}
{"text": "駅まで歩いて十分くらいかかります。", "chunks": ["えきまで", "あるいて", "じゅっぷん", "くらい", "かかります。"], "level": "A", "use": "daily"}
{"text": "打ち合わせの時間を変えてもらえますか。", "chunks": ["うちあわせの", "じかんを", "かえて", "もらえますか。"], "level": "A", "use": "work"}
{"text": "もうすぐ誕生日だね。", "chunks": ["もうすぐ", "たんじょうびだね。"], "level": "A", "use": "chat"}
{"text": "犬と一緒に公園を散歩した。", "chunks": ["いぬと", "いっしょに", "こうえんを", "さんぽした。"], "level": "A", "use": "daily"}
{"text": "先生にメールで質問を送りました。", "chunks": ["せんせいに", "めーるで", "しつもんを", "おくりました。"], "level": "A", "use": "work"}
{"text": "最近忙しくてなかなか連絡できなかった。", "chunks": ["さいきん", "いそがしくて", "なかなか", "れんらく", "できなかった。"], "level": "A", "use": "chat"}
{"text": "台所の電気を消し忘れてしまった。", "chunks": ["だいどころの", "でんきを", "けしわすれて", "しまった。"], "level": "A", "use": "daily"}
{"text": "新しい担当者を紹介します。", "chunks": ["あたらしい", "たんとうしゃを", "しょうかいします。"], "level": "A", "use": "work"}
{"text": "週末は家でゆっくりするつもり。", "chunks": ["しゅうまつは", "いえで", "ゆっくり", "するつもり。"], "level": "A", "use": "chat"}
{"text": "薬を飲んでから少し寝ました。", "chunks": ["くすりを", "のんでから", "すこし", "ねました。"], "level": "A", "use": "daily"}
{"text": "出張の予定をカレンダーに入れておきます。", "chunks": ["しゅっちょうの", "よていを", "かれんだーに", "いれて", "おきます。"], "level": "A", "use": "work"}
{"text": "その話、初めて聞いたよ。", "chunks": ["その", "はなし、はじめて", "きいたよ。"], "level": "A", "use": "chat"}
{"text": "雨が降りそうなので傘を持って行きます。", "chunks": ["あめが", "ふりそうなので", "かさを", "もって", "いきます。"], "level": "A", "use": "daily"}
{"text": "来月から新しい仕事が始まります。", "chunks": ["らいげつから", "あたらしい", "しごとが", "はじまります。"], "level": "A", "use": "work"}
{"text": "元気にしてる？", "chunks": ["げんきに", "してる？"], "level": "A", "use": "chat"}
{"text": "お風呂に入って早く寝る。", "chunks": ["おふろに", "はいって", "はやく", "ねる。"], "level": "A", "use": "daily"}
{"text": "返事をお待ちしております。", "chunks": ["へんじを", "おまち", "しております。"], "level": "A", "use": "work"}
{"text": "ごめん、少し遅れるかも。", "chunks": ["ごめん、すこし", "おくれるかも。"], "level": "A", "use": "chat"}
{"text": "冷蔵庫に卵が二つ残っている。", "chunks": ["れいぞうこに", "たまごが", "ふたつ", "のこっている。"], "level": "A", "use": "daily"}
{"text": "会社の近くで昼ご飯を食べました。", "chunks": ["かいしゃの", "ちかくで", "ひるごはんを", "たべました。"], "level": "A", "use": "work"}
{"text": "この前教えてくれたお店に行ってみたよ。とても美味しかった。", "chunks": ["このまえ", "おしえてくれた", "おみせに", "いってみたよ。とても", "おいしかった。"], "level": "A", "use": "chat"}
{"text": "毎朝六時に起きて、散歩をしてから朝ごはんを作ります。", "chunks": ["まいあさ", "ろくじに", "おきて、さんぽを", "してから", "あさごはんを", "つくります。"], "level": "A", "use": "daily"}
{"text": "今日の会議で決まったことをまとめて、みんなにメールで送ってください。", "chunks": ["きょうの", "かいぎで", "きまった", "ことを", "まとめて、みんなに", "めーるで", "おくって", "ください。"], "level": "A", "use": "work"}
{"text": "旅行の写真を見せてほしいな。いつ頃行ったの？", "chunks": ["りょこうの", "しゃしんを", "みせて", "ほしいな。いつごろ", "いったの？"], "level": "A", "use": "chat"}
{"text": "週末は友達を家に呼んで、みんなで鍋を食べる予定です。", "chunks": ["しゅうまつは", "ともだちを", "いえに", "よんで、みんなで", "なべを", "たべる", "よていです。"], "level": "A", "use": "daily"}
{"text": "資料の最後のページに、連絡先を書いておいてもらえると助かります。", "chunks": ["しりょうの", "さいごの", "ぺーじに、れんらくさきを", "かいて", "おいて", "もらえると", "たすかります。"], "level": "A", "use": "work"}
{"text": "明日は朝から用事があるので、夜になったら連絡するね。", "chunks": ["あしたは", "あさから", "ようじが", "あるので、よるに", "なったら", "れんらくするね。"], "level": "A", "use": "chat"}
{"text": "最近は天気がいい日が続いているので、洗濯がはかどります。", "chunks": ["さいきんは", "てんきが", "いいひが", "つづいているので、せんたくが", "はかどります。"], "level": "A", "use": "daily"}
{"text": "お忙しいところ恐れ入りますが、来週までにご確認をお願いします。", "chunks": ["おいそがしい", "ところ", "おそれいりますが、らいしゅうまでに", "ごかくにんを", "おねがいします。"], "level": "A", "use": "work"}
{"text": "今日はありがとう。また近いうちに会おうね。", "chunks": ["きょうは", "ありがとう。また", "ちかいうちに", "あおうね。"], "level": "A", "use": "chat"}
{"text": "スーパーで野菜と魚を買って、夕飯の準備をしました。", "chunks": ["すーぱーで", "やさいと", "さかなを", "かって、ゆうはんの", "じゅんびを", "しました。"], "level": "A", "use": "daily"}
{"text": "新入社員の研修が来週から始まるので、部屋を予約しておきます。", "chunks": ["しんにゅうしゃいんの", "けんしゅうが", "らいしゅうから", "はじまるので、へやを", "よやくして", "おきます。"], "level": "A", "use": "work"}
{"text": "ちょっと待って、すぐ行くから。", "chunks": ["ちょっと", "まって、すぐ", "いくから。"], "level": "A", "use": "chat"}
{"text": "電車が遅れていて、学校に着くのが少し遅くなった。", "chunks": ["でんしゃが", "おくれていて、がっこうに", "つくのが", "すこし", "おそく", "なった。"], "level": "A", "use": "daily"}
{"text": "見積もりの金額について、もう一度相談させてください。", "chunks": ["みつもりの", "きんがくについて、もういちど", "そうだん", "させて", "ください。"], "level": "A", "use": "work"}
{"text": "窓を開けると風が気持ちいい。", "chunks": ["まどを", "あけると", "かぜが", "きもちいい。"], "level": "A", "use": "daily"}
{"text": "うん、それでいいと思う。", "chunks": ["うん、それで", "いいと", "おもう。"], "level": "A", "use": "chat"}
{"text": "机の整理をしてから帰ります。", "chunks": ["つくえの", "せいりを", "してから", "かえります。"], "level": "A", "use": "work"}
{"text": "母から荷物が届きました。", "chunks": ["ははから", "にもつが", "とどきました。"], "level": "A", "use": "daily"}
{"text": "夜ご飯は何にする？", "chunks": ["よるごはんは", "なんに", "する？"], "level": "A", "use": "chat"}
{"text": "電話に出られなくてすみません。", "chunks": ["でんわに", "でられなくて", "すみません。"], "level": "A", "use": "work"}
{"text": "子どもが公園で遊んでいる。", "chunks": ["こどもが", "こうえんで", "あそんでいる。"], "level": "A", "use": "daily"}
{"text": "それは大変だったね。", "chunks": ["それは", "たいへんだったね。"], "level": "A", "use": "chat"}
{"text": "明日の準備はもう終わりました。", "chunks": ["あしたの", "じゅんびは", "もう", "おわりました。"], "level": "A", "use": "work"}
{"text": "今日は海がとてもきれいだ。", "chunks": ["きょうは", "うみが", "とても", "きれいだ。"], "level": "A", "use": "daily"}
{"text": "映画のチケットを二枚取ったよ。", "chunks": ["えいがの", "ちけっとを", "にまい", "とったよ。"], "level": "A", "use": "chat"}
{"text": "部長は今ちょうど出かけています。", "chunks": ["ぶちょうは", "いま", "ちょうど", "でかけています。"], "level": "A", "use": "work"}
{"text": "新しい靴を買って足が痛い。", "chunks": ["あたらしい", "くつを", "かって", "あしが", "いたい。"], "level": "A", "use": "daily"}
{"text": "今夜は星がよく見えるよ。", "chunks": ["こんやは", "ほしが", "よく", "みえるよ。"], "level": "A", "use": "chat"}
{"text": "書類にサインをお願いします。", "chunks": ["しょるいに", "さいんを", "おねがいします。"], "level": "A", "use": "work"}
{"text": "トマトとたまねぎを切ってサラダを作る。", "chunks": ["とまとと", "たまねぎを", "きって", "さらだを", "つくる。"], "level": "A", "use": "daily"}
{"text": "いつでも連絡してね。", "chunks": ["いつでも", "れんらくしてね。"], "level": "A", "use": "chat"}
{"text": "今月の売り上げは先月より良かったです。", "chunks": ["こんげつの", "うりあげは", "せんげつより", "よかったです。"], "level": "A", "use": "work"}
{"text": "電気代が少し高くなった気がする。", "chunks": ["でんきだいが", "すこし", "たかく", "なった", "きがする。"], "level": "A", "use": "daily"}
{"text": "さっきの話、本当なの？", "chunks": ["さっきの", "はなし、ほんとうなの？"], "level": "A", "use": "chat"}
{"text": "会議室の鍵を借りてきます。", "chunks": ["かいぎしつの", "かぎを", "かりてきます。"], "level": "A", "use": "work"}
{"text": "庭の花に水をやるのを忘れていた。", "chunks": ["にわの", "はなに", "みずを", "やるのを", "わすれていた。"], "level": "A", "use": "daily"}
{"text": "眠くてもう目が開かない。", "chunks": ["ねむくて", "もう", "めが", "あかない。"], "level": "A", "use": "chat"}
{"text": "コピー機の紙がなくなりました。", "chunks": ["こぴーきの", "かみが", "なくなりました。"], "level": "A", "use": "work"}
{"text": "姉は毎日バスで会社に通っている。", "chunks": ["あねは", "まいにち", "ばすで", "かいしゃに", "かよっている。"], "level": "A", "use": "daily"}
{"text": "ちょっと電話してもいい？", "chunks": ["ちょっと", "でんわしても", "いい？"], "level": "A", "use": "chat"}
{"text": "来週の火曜日は休みを取る予定です。", "chunks": ["らいしゅうの", "かようびは", "やすみを", "とる", "よていです。"], "level": "A", "use": "work"}
{"text": "ご飯が炊けたので、みんなで食べましょう。", "chunks": ["ごはんが", "たけたので、みんなで", "たべましょう。"], "level": "A", "use": "daily"}
{"text": "あの店、前より人が増えたね。", "chunks": ["あの", "みせ、まえより", "ひとが", "ふえたね。"], "level": "A", "use": "chat"}
{"text": "担当の者に代わりますので少々お待ちください。", "chunks": ["たんとうの", "ものに", "かわりますので", "しょうしょう", "おまち", "ください。"], "level": "A", "use": "work"}
{"text": "冬になる前にコートを出しておこう。", "chunks": ["ふゆに", "なるまえに", "こーとを", "だしておこう。"], "level": "A", "use": "daily"}
{"text": "一緒に宿題をやらない？", "chunks": ["いっしょに", "しゅくだいを", "やらない？"], "level": "A", "use": "chat"}
{"text": "ここに名前と住所を書いてください。", "chunks": ["ここに", "なまえと", "じゅうしょを", "かいて", "ください。"], "level": "A", "use": "work"}
{"text": "大きな音で目が覚めてしまった。", "chunks": ["おおきな", "おとで", "めが", "さめて", "しまった。"], "level": "A", "use": "daily"}
{"text": "今日の晩ごはんはカレーだって。", "chunks": ["きょうの", "ばんごはんは", "かれーだって。"], "level": "A", "use": "chat"}
{"text": "仕事が終わったらすぐに連絡します。", "chunks": ["しごとが", "おわったら", "すぐに", "れんらくします。"], "level": "A", "use": "work"}
{"text": "庭に小さな鳥が来ていました。", "chunks": ["にわに", "ちいさな", "とりが", "きていました。"], "level": "A", "use": "daily"}
{"text": "雨が止んだら散歩に行こうよ。夕方なら涼しいと思う。", "chunks": ["あめが", "やんだら", "さんぽに", "いこうよ。ゆうがたなら", "すずしいと", "おもう。"], "level": "A", "use": "chat"}
{"text": "今日は急な用事で早く帰らなければなりませんので、続きは明日お願いします。", "chunks": ["きょうは", "きゅうな", "ようじで", "はやく", "かえらなければ", "なりませんので、つづきは", "あした", "おねがいします。"], "level": "A", "use": "work"}
{"text": "朝起きて窓を開けたら、庭に雪が積もっていてとても驚きました。", "chunks": ["あさ", "おきて", "まどを", "あけたら、にわに", "ゆきが", "つもっていて", "とても", "おどろきました。"], "level": "A", "use": "daily"}
{"text": "この間借りた本、まだ読み終わってないんだ。もう少し待ってくれる？", "chunks": ["このあいだ", "かりた", "ほん、まだ", "よみおわって", "ないんだ。もうすこし", "まってくれる？"], "level": "A", "use": "chat"}
{"text": "お問い合わせいただいた件について、担当者から折り返しご連絡いたします。", "chunks": ["おといあわせ", "いただいた", "けんについて、たんとうしゃから", "おりかえし", "ごれんらく", "いたします。"], "level": "A", "use": "work"}
{"text": "休みの日は、近くの図書館で本を読んだり、散歩をしたりして過ごします。", "chunks": ["やすみのひは、ちかくの", "としょかんで", "ほんを", "よんだり、さんぽを", "したりして", "すごします。"], "level": "A", "use": "daily"}
{"text": "昨日は遅くまで起きていたから、今日はずっと眠いんだよね。", "chunks": ["きのうは", "おそくまで", "おきていたから、きょうは", "ずっと", "ねむいんだよね。"], "level": "A", "use": "chat"}
{"text": "新しい企画について、来週の会議でみんなの意見を聞きたいと思っています。", "chunks": ["あたらしい", "きかくについて、らいしゅうの", "かいぎで", "みんなの", "いけんを", "ききたいと", "おもっています。"], "level": "A", "use": "work"}
{"text": "買い物のついでに、郵便局で荷物を出してきました。", "chunks": ["かいものの", "ついでに、ゆうびんきょくで", "にもつを", "だして", "きました。"], "level": "A", "use": "daily"}
{"text": "ねえ、今度の日曜日、空いてる？", "chunks": ["ねえ、こんどの", "にちようび、あいてる？"], "level": "A", "use": "chat"}
{"text": "ご不明な点がありましたら、いつでもお声がけください。", "chunks": ["ごふめいな", "てんが", "ありましたら、いつでも", "おこえがけ", "ください。"], "level": "A", "use": "work"}
{"text": "今朝は少し早く目が覚めた。", "chunks": ["けさは", "すこし", "はやく", "めが", "さめた。"], "level": "A", "use": "daily"}
{"text": "ごめんね、返事が遅くなって。", "chunks": ["ごめんね、へんじが", "おそく", "なって。"], "level": "A", "use": "chat"}
{"text": "この件は私が担当します。", "chunks": ["この", "けんは", "わたしが", "たんとうします。"], "level": "A", "use": "work"}
{"text": "夜の道は暗いので気をつけて。", "chunks": ["よるの", "みちは", "くらいので", "きをつけて。"], "level": "A", "use": "daily"}
{"text": "それ、いいアイデアだね。", "chunks": ["それ、いい", "あいであだね。"], "level": "A", "use": "chat"}
{"text": "今日の昼休みは一時間です。", "chunks": ["きょうの", "ひるやすみは", "いちじかんです。"], "level": "A", "use": "work"}
{"text": "風邪をひいて喉が痛い。", "chunks": ["かぜを", "ひいて", "のどが", "いたい。"], "level": "A", "use": "daily"}
{"text": "私も同じことを考えてたよ。", "chunks": ["わたしも", "おなじ", "ことを", "かんがえてたよ。"], "level": "A", "use": "chat"}
{"text": "会議の資料をプリントしてください。", "chunks": ["かいぎの", "しりょうを", "ぷりんとして", "ください。"], "level": "A", "use": "work"}
{"text": "公園の桜がもうすぐ咲きそうだ。", "chunks": ["こうえんの", "さくらが", "もうすぐ", "さきそうだ。"], "level": "A", "use": "daily"}
{"text": "週末、天気が良かったらいいな。", "chunks": ["しゅうまつ、てんきが", "よかったら", "いいな。"], "level": "A", "use": "chat"}
{"text": "上司に相談してから返事をします。", "chunks": ["じょうしに", "そうだんしてから", "へんじを", "します。"], "level": "A", "use": "work"}
{"text": "お茶を入れるから座って待っていて。", "chunks": ["おちゃを", "いれるから", "すわって", "まっていて。"], "level": "A", "use": "daily"}
{"text": "お誕生日おめでとう。", "chunks": ["おたんじょうび", "おめでとう。"], "level": "A", "use": "chat"}
{"text": "ご注文の商品は明日届きます。", "chunks": ["ごちゅうもんの", "しょうひんは", "あした", "とどきます。"], "level": "A", "use": "work"}
{"text": "弟は毎晩ゲームばかりしている。", "chunks": ["おとうとは", "まいばん", "げーむばかり", "している。"], "level": "A", "use": "daily"}
{"text": "この服、似合うかな？", "chunks": ["この", "ふく、にあうかな？"], "level": "A", "use": "chat"}
{"text": "締め切りは金曜日の夕方です。", "chunks": ["しめきりは", "きんようびの", "ゆうがたです。"], "level": "A", "use": "work"}
{"text": "ベランダで小さな野菜を育てている。", "chunks": ["べらんだで", "ちいさな", "やさいを", "そだてている。"], "level": "A", "use": "daily"}
{"text": "あとで写真送るね。", "chunks": ["あとで", "しゃしん", "おくるね。"], "level": "A", "use": "chat"}
{"text": "会議に遅れそうなので先に始めてください。", "chunks": ["かいぎに", "おくれそうなので", "さきに", "はじめて", "ください。"], "level": "A", "use": "work"}
{"text": "夏休みに家族で山へ行きました。", "chunks": ["なつやすみに", "かぞくで", "やまへ", "いきました。"], "level": "A", "use": "daily"}
{"text": "おいしいケーキを見つけたんだ。", "chunks": ["おいしい", "けーきを", "みつけたんだ。"], "level": "A", "use": "chat"}
{"text": "今日はお休みをいただいております。", "chunks": ["きょうは", "おやすみを", "いただいております。"], "level": "A", "use": "work"}
{"text": "寝る前に温かい牛乳を飲む。", "chunks": ["ねる", "まえに", "あたたかい", "ぎゅうにゅうを", "のむ。"], "level": "A", "use": "daily"}
{"text": "最近、運動してる？", "chunks": ["さいきん、うんどう", "してる？"], "level": "A", "use": "chat"}
{"text": "担当者の名前を教えてください。", "chunks": ["たんとうしゃの", "なまえを", "おしえて", "ください。"], "level": "A", "use": "work"}
{"text": "兄は来年の春に結婚します。", "chunks": ["あには", "らいねんの", "はるに", "けっこんします。"], "level": "A", "use": "daily"}
{"text": "宿題はもう終わったの？", "chunks": ["しゅくだいは", "もう", "おわったの？"], "level": "A", "use": "chat"}
{"text": "取引先に挨拶に行ってきます。", "chunks": ["とりひきさきに", "あいさつに", "いってきます。"], "level": "A", "use": "work"}
{"text": "店の前に長い列ができていた。", "chunks": ["みせの", "まえに", "ながい", "れつが", "できていた。"], "level": "A", "use": "daily"}
{"text": "眠れなくて朝まで起きてたよ。", "chunks": ["ねむれなくて", "あさまで", "おきてたよ。"], "level": "A", "use": "chat"}
{"text": "先週お送りした資料はご覧になりましたか。", "chunks": ["せんしゅう", "おおくりした", "しりょうは", "ごらんに", "なりましたか。"], "level": "A", "use": "work"}
{"text": "祖母は毎日手紙を書いている。", "chunks": ["そぼは", "まいにち", "てがみを", "かいている。"], "level": "A", "use": "daily"}
{"text": "いま駅に着いたところ。", "chunks": ["いま", "えきに", "ついた", "ところ。"], "level": "A", "use": "chat"}
{"text": "昼までに返信が必要な案件があります。", "chunks": ["ひるまでに", "へんしんが", "ひつような", "あんけんが", "あります。"], "level": "A", "use": "work"}
{"text": "窓を閉めないと虫が入ってくる。", "chunks": ["まどを", "しめないと", "むしが", "はいってくる。"], "level": "A", "use": "daily"}
{"text": "この歌、ずっと聞いていたいな。", "chunks": ["この", "うた、ずっと", "きいていたいな。"], "level": "A", "use": "chat"}
{"text": "お電話ありがとうございます。", "chunks": ["おでんわ", "ありがとう", "ございます。"], "level": "A", "use": "work"}
{"text": "家の近くに新しいパン屋ができた。", "chunks": ["いえの", "ちかくに", "あたらしい", "ぱんやが", "できた。"], "level": "A", "use": "daily"}
{"text": "大丈夫、心配しないで。", "chunks": ["だいじょうぶ、しんぱい", "しないで。"], "level": "A", "use": "chat"}
{"text": "会議が長引いたので、予定より遅くなりました。", "chunks": ["かいぎが", "ながびいたので、よていより", "おそく", "なりました。"], "level": "A", "use": "work"}
{"text": "毎週日曜日は家族みんなで朝ごはんを食べる。", "chunks": ["まいしゅう", "にちようびは", "かぞく", "みんなで", "あさごはんを", "たべる。"], "level": "A", "use": "daily"}
{"text": "もし時間があったら、駅前のカフェでお茶でもどう？", "chunks": ["もし", "じかんが", "あったら、えきまえの", "かふぇで", "おちゃでも", "どう？"], "level": "A", "use": "chat"}
{"text": "資料の数字が間違っていたので、直してもう一度送ります。", "chunks": ["しりょうの", "すうじが", "まちがっていたので、なおして", "もういちど", "おくります。"], "level": "A", "use": "work"}
{"text": "夕方になると、近所の子どもたちが元気に帰ってくる。", "chunks": ["ゆうがたに", "なると、きんじょの", "こどもたちが", "げんきに", "かえってくる。"], "level": "A", "use": "daily"}
{"text": "昨日は楽しかったね。また行きたいな。", "chunks": ["きのうは", "たのしかったね。また", "いきたいな。"], "level": "A", "use": "chat"}
{"text": "田中さんは今、お客様と打ち合わせ中です。", "chunks": ["たなかさんは", "いま、おきゃくさまと", "うちあわせちゅうです。"], "level": "A", "use": "work"}
{"text": "雨の日は電車が混んでいて、座れないことが多い。", "chunks": ["あめのひは", "でんしゃが", "こんでいて、すわれない", "ことが", "おおい。"], "level": "A", "use": "daily"}
{"text": "おすすめの本があったら教えてほしいな。", "chunks": ["おすすめの", "ほんが", "あったら", "おしえて", "ほしいな。"], "level": "A", "use": "chat"}
{"text": "今日は昼から雨が降る。", "chunks": ["きょうは", "ひるから", "あめが", "ふる。"], "level": "A", "use": "daily"}
{"text": "お先に失礼します。", "chunks": ["おさきに", "しつれいします。"], "level": "A", "use": "chat"}
{"text": "資料を確認しました。", "chunks": ["しりょうを", "かくにん", "しました。"], "level": "A", "use": "work"}
{"text": "赤い花がたくさん咲いている。", "chunks": ["あかい", "はなが", "たくさん", "さいている。"], "level": "A", "use": "daily"}
{"text": "もう少しだけ待ってて。", "chunks": ["もうすこし", "だけ", "まってて。"], "level": "A", "use": "chat"}
{"text": "来週の月曜日にお伺いします。", "chunks": ["らいしゅうの", "げつようびに", "おうかがいします。"], "level": "A", "use": "work"}
{"text": "ご飯の後に果物を食べた。", "chunks": ["ごはんの", "あとに", "くだものを", "たべた。"], "level": "A", "use": "daily"}
{"text": "じゃあ、また明日ね。", "chunks": ["じゃあ、また", "あしたね。"], "level": "A", "use": "chat"}
{"text": "机の引き出しに鍵をかけた。", "chunks": ["つくえの", "ひきだしに", "かぎを", "かけた。"], "level": "A", "use": "work"}
{"text": "空がだんだん暗くなってきた。", "chunks": ["そらが", "だんだん", "くらく", "なってきた。"], "level": "A", "use": "daily"}
{"text": "そろそろ出発しようか。", "chunks": ["そろそろ", "しゅっぱつ", "しようか。"], "level": "A", "use": "chat"}
{"text": "担当を変更させていただきます。", "chunks": ["たんとうを", "へんこう", "させて", "いただきます。"], "level": "A", "use": "work"}
{"text": "妹は絵を描くのが好きだ。", "chunks": ["いもうとは", "えを", "かくのが", "すきだ。"], "level": "A", "use": "daily"}
{"text": "今日、すごく寒くない？", "chunks": ["きょう、すごく", "さむくない？"], "level": "A", "use": "chat"}
{"text": "会議の議事録を作成しました。", "chunks": ["かいぎの", "ぎじろくを", "さくせい", "しました。"], "level": "A", "use": "work"}
{"text": "スーパーで特売のお肉を買った。", "chunks": ["すーぱーで", "とくばいの", "おにくを", "かった。"], "level": "A", "use": "daily"}
{"text": "その考え方、いいと思うよ。", "chunks": ["その", "かんがえかた、いいと", "おもうよ。"], "level": "A", "use": "chat"}
{"text": "今朝から体調が悪いので休みます。", "chunks": ["けさから", "たいちょうが", "わるいので", "やすみます。"], "level": "A", "use": "work"}
{"text": "週末に部屋の大掃除をした。", "chunks": ["しゅうまつに", "へやの", "おおそうじを", "した。"], "level": "A", "use": "daily"}
{"text": "ねえ、これ見て！", "chunks": ["ねえ、これ", "みて！"], "level": "A", "use": "chat"}
{"text": "明日までに提出してください。", "chunks": ["あしたまでに", "ていしゅつ", "して", "ください。"], "level": "A", "use": "work"}
{"text": "公園のベンチで本を読んだ。", "chunks": ["こうえんの", "べんちで", "ほんを", "よんだ。"], "level": "A", "use": "daily"}
{"text": "今度は私がおごるよ。", "chunks": ["こんどは", "わたしが", "おごるよ。"], "level": "A", "use": "chat"}

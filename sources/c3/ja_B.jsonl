{"text": "会議の後で、少し話せる時間はある？", "chunks": ["かいぎの", "あとで、すこし", "はなせる", "じかんは", "ある？"], "level": "B", "use": "chat"}
{"text": "在宅勤務になってから、通勤の時間を勉強に使えるようになった。", "chunks": ["ざいたく", "きんむに", "なってから、つうきんの", "じかんを", "べんきょうに", "つかえるように", "なった。"], "level": "B", "use": "work"}
{"text": "新聞を取るのをやめて、ニュースはスマホで見るようにした。", "chunks": ["しんぶんを", "とるのを", "やめて、にゅーすは", "すまほで", "みるように", "した。"], "level": "B", "use": "daily"}
{"text": "同じ失敗を繰り返さないように、メモを残しておくよ。", "chunks": ["おなじ", "しっぱいを", "くりかえさないように、めもを", "のこして", "おくよ。"], "level": "B", "use": "chat"}
{"text": "商品の説明書を読み直して、使い方を確認し直した。", "chunks": ["しょうひんの", "せつめいしょを", "よみなおして、つかいかたを", "かくにん", "しなおした。"], "level": "B", "use": "work"}
{"text": "散歩の帰りに雨に降られたよ。", "chunks": ["さんぽの", "かえりに", "あめに", "ふられたよ。"], "level": "B", "use": "chat"}
{"text": "書類を郵送で受け付けています。", "chunks": ["しょるいを", "ゆうそうで", "うけつけています。"], "level": "B", "use": "work"}
{"text": "兄は毎朝ジョギングを欠かさない。", "chunks": ["あには", "まいあさ", "じょぎんぐを", "かかさない。"], "level": "B", "use": "daily"}
{"text": "試合に勝って嬉しかった。", "chunks": ["しあいに", "かって", "うれしかった。"], "level": "B", "use": "chat"}
{"text": "担当部署に問い合わせてみます。", "chunks": ["たんとう", "ぶしょに", "といあわせて", "みます。"], "level": "B", "use": "work"}
{"text": "玄関の靴を揃えて並べた。", "chunks": ["げんかんの", "くつを", "そろえて", "ならべた。"], "level": "B", "use": "daily"}
{"text": "設定画面から言語を切り替える。", "chunks": ["せっていがめんから", "げんごを", "きりかえる。"], "level": "B", "use": "tech"}
{"text": "傘を忘れて濡れて帰った。", "chunks": ["かさを", "わすれて", "ぬれて", "かえった。"], "level": "B", "use": "chat"}
{"text": "仕事の優先順位を整理する。", "chunks": ["しごとの", "ゆうせん", "じゅんいを", "せいり", "する。"], "level": "B", "use": "work"}
{"text": "窓際に植木鉢を並べている。", "chunks": ["まどぎわに", "うえきばちを", "ならべている。"], "level": "B", "use": "daily"}
{"text": "彼の話は信じがたいな。", "chunks": ["かれの", "はなしは", "しんじがたいな。"], "level": "B", "use": "chat"}
{"text": "報告の期限に間に合わせる。", "chunks": ["ほうこくの", "きげんに", "まにあわせる。"], "level": "B", "use": "work"}
{"text": "おじいちゃんの家で柿をもらった。", "chunks": ["おじいちゃんの", "いえで", "かきを", "もらった。"], "level": "B", "use": "daily"}
{"text": "機能を追加して使いやすくした。", "chunks": ["きのうを", "ついか", "して", "つかいやすく", "した。"], "level": "B", "use": "tech"}
{"text": "友達の結婚式に招待された。", "chunks": ["ともだちの", "けっこんしきに", "しょうたい", "された。"], "level": "B", "use": "chat"}
{"text": "客の要望に応える。", "chunks": ["きゃくの", "ようぼうに", "こたえる。"], "level": "B", "use": "work"}
{"text": "秋は食べ物がおいしい季節だ。", "chunks": ["あきは", "たべものが", "おいしい", "きせつだ。"], "level": "B", "use": "daily"}
{"text": "すぐ戻るから席を取っておいて。", "chunks": ["すぐ", "もどるから", "せきを", "とっておいて。"], "level": "B", "use": "chat"}
{"text": "経費の精算を済ませてください。", "chunks": ["けいひの", "せいさんを", "すませて", "ください。"], "level": "B", "use": "work"}
{"text": "犬の散歩中に雨が降り出した。", "chunks": ["いぬの", "さんぽちゅうに", "あめが", "ふりだした。"], "level": "B", "use": "daily"}
{"text": "この曲、聞き覚えがあるな。", "chunks": ["この", "きょく、ききおぼえが", "あるな。"], "level": "B", "use": "chat"}
{"text": "新人の教育を任された。", "chunks": ["しんじんの", "きょういくを", "まかされた。"], "level": "B", "use": "work"}
{"text": "寒さで指先が冷たくなった。", "chunks": ["さむさで", "ゆびさきが", "つめたく", "なった。"], "level": "B", "use": "daily"}
{"text": "無線の電波が弱くて途切れる。", "chunks": ["むせんの", "でんぱが", "よわくて", "とぎれる。"], "level": "B", "use": "tech"}
{"text": "旅行の計画を立てるのが楽しい。", "chunks": ["りょこうの", "けいかくを", "たてるのが", "たのしい。"], "level": "B", "use": "chat"}
{"text": "仕事の進み具合を報告する。", "chunks": ["しごとの", "すすみぐあいを", "ほうこく", "する。"], "level": "B", "use": "work"}
{"text": "朝一番に窓を開けて空気を入れ替える。", "chunks": ["あさいちばんに", "まどを", "あけて", "くうきを", "いれかえる。"], "level": "B", "use": "daily"}
{"text": "何も言わずに行ってしまった。", "chunks": ["なにも", "いわずに", "いってしまった。"], "level": "B", "use": "chat"}
{"text": "倉庫の在庫を数え直す。", "chunks": ["そうこの", "ざいこを", "かぞえなおす。"], "level": "B", "use": "work"}
{"text": "石の上にも三年と言うからね。", "chunks": ["いしの", "うえにも", "さんねんと", "いうからね。"], "level": "B", "use": "daily"}
{"text": "今日は頭が痛くて休んだよ。", "chunks": ["きょうは", "あたまが", "いたくて", "やすんだよ。"], "level": "B", "use": "chat"}
{"text": "相手の意図を汲み取る。", "chunks": ["あいての", "いとを", "くみとる。"], "level": "B", "use": "work"}
{"text": "寝る前にストレッチをして体をほぐす。", "chunks": ["ねる", "まえに", "すとれっちを", "して", "からだを", "ほぐす。"], "level": "B", "use": "daily"}
{"text": "ケーキを三等分に切り分けた。", "chunks": ["けーきを", "さんとうぶんに", "きりわけた。"], "level": "B", "use": "chat"}
{"text": "過去の事例を参考にして対策を立てる。", "chunks": ["かこの", "じれいを", "さんこうに", "して", "たいさくを", "たてる。"], "level": "B", "use": "work"}
{"text": "野菜を細かく刻んでスープに入れた。", "chunks": ["やさいを", "こまかく", "きざんで", "すーぷに", "いれた。"], "level": "B", "use": "daily"}
{"text": "電池が切れそうなので充電する。", "chunks": ["でんちが", "きれそうなので", "じゅうでん", "する。"], "level": "B", "use": "tech"}
{"text": "朝食を抜くと昼にお腹がすくよね。", "chunks": ["ちょうしょくを", "ぬくと", "ひるに", "おなかが", "すくよね。"], "level": "B", "use": "chat"}
{"text": "出張の費用を会社に請求した。", "chunks": ["しゅっちょうの", "ひようを", "かいしゃに", "せいきゅう", "した。"], "level": "B", "use": "work"}
{"text": "遠くで雷が鳴っているのが聞こえる。", "chunks": ["とおくで", "かみなりが", "なっているのが", "きこえる。"], "level": "B", "use": "daily"}
{"text": "席が埋まる前に早めに行こう。", "chunks": ["せきが", "うまる", "まえに", "はやめに", "いこう。"], "level": "B", "use": "chat"}
{"text": "会議の議事を記録する係を決める。", "chunks": ["かいぎの", "ぎじを", "きろく", "する", "かかりを", "きめる。"], "level": "B", "use": "work"}
{"text": "牛乳が腐る前に使い切りたい。", "chunks": ["ぎゅうにゅうが", "くさる", "まえに", "つかいきりたい。"], "level": "B", "use": "daily"}
{"text": "彼女は誰にでも親切だよね。", "chunks": ["かのじょは", "だれにでも", "しんせつだよね。"], "level": "B", "use": "chat"}
{"text": "収入と支出を帳簿に記入する。", "chunks": ["しゅうにゅうと", "ししゅつを", "ちょうぼに", "きにゅう", "する。"], "level": "B", "use": "work"}
{"text": "海の近くに住むのが夢だった。", "chunks": ["うみの", "ちかくに", "すむのが", "ゆめだった。"], "level": "B", "use": "daily"}
{"text": "音声を文字に変換する機能を使う。", "chunks": ["おんせいを", "もじに", "へんかん", "する", "きのうを", "つかう。"], "level": "B", "use": "tech"}
{"text": "眠気覚ましにコーヒーを飲んだ。", "chunks": ["ねむけざましに", "こーひーを", "のんだ。"], "level": "B", "use": "chat"}
{"text": "会議は二時から始まります。", "chunks": ["かいぎは", "にじから", "はじまります。"], "level": "B", "use": "numbers"}
{"text": "昼食に五百円を使った。", "chunks": ["ちゅうしょくに", "ごひゃくえんを", "つかった。"], "level": "B", "use": "numbers"}
{"text": "席を譲ってくれてありがとう。", "chunks": ["せきを", "ゆずってくれて", "ありがとう。"], "level": "B", "use": "chat"}
{"text": "意外な結果に驚いている。", "chunks": ["いがいな", "けっかに", "おどろいている。"], "level": "B", "use": "work"}
{"text": "冷たい飲み物ばかり飲むと体が冷える。", "chunks": ["つめたい", "のみものばかり", "のむと", "からだが", "ひえる。"], "level": "B", "use": "daily"}
{"text": "夏の思い出を絵日記に描いた。", "chunks": ["なつの", "おもいでを", "えにっきに", "かいた。"], "level": "B", "use": "chat"}
{"text": "技術を磨いて資格を取る。", "chunks": ["ぎじゅつを", "みがいて", "しかくを", "とる。"], "level": "B", "use": "work"}
{"text": "窓の外を鳥が飛んでいった。", "chunks": ["まどの", "そとを", "とりが", "とんでいった。"], "level": "B", "use": "daily"}
{"text": "文書の変更履歴を残しておく。", "chunks": ["ぶんしょの", "へんこう", "りれきを", "のこして", "おく。"], "level": "B", "use": "tech"}
{"text": "待ち合わせの場所を間違えた。", "chunks": ["まちあわせの", "ばしょを", "まちがえた。"], "level": "B", "use": "chat"}
{"text": "契約を結ぶ前に条件を確かめる。", "chunks": ["けいやくを", "むすぶ", "まえに", "じょうけんを", "たしかめる。"], "level": "B", "use": "work"}
{"text": "体を温めるために生姜湯を飲んだ。", "chunks": ["からだを", "あたためるために", "しょうがゆを", "のんだ。"], "level": "B", "use": "daily"}
{"text": "早めに予約したほうが安心だよ。", "chunks": ["はやめに", "よやく", "したほうが", "あんしんだよ。"], "level": "B", "use": "chat"}
{"text": "相談に乗ってもらって助かりました。", "chunks": ["そうだんに", "のってもらって", "たすかりました。"], "level": "B", "use": "work"}
{"text": "家族で食卓を囲む時間を大切にしている。", "chunks": ["かぞくで", "しょくたくを", "かこむ", "じかんを", "たいせつに", "している。"], "level": "B", "use": "daily"}
{"text": "電車は三番線から出ます。", "chunks": ["でんしゃは", "さんばんせんから", "でます。"], "level": "B", "use": "numbers"}
{"text": "共有フォルダの場所を教えてください。", "chunks": ["きょうゆう", "ふぉるだの", "ばしょを", "おしえて", "ください。"], "level": "B", "use": "tech"}
{"text": "その作戦で行ってみよう。", "chunks": ["その", "さくせんで", "いってみよう。"], "level": "B", "use": "chat"}
